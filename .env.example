# Firebase web configuration.
#
# These are public values — they ship inside the client bundle and Google
# documents the web API key as an identifier, not a secret. They live here
# rather than in source so that no credential-shaped literal sits in the
# repository and so they can be rotated without a code change. The controls
# that actually protect the project are firestore.rules, the Firebase
# authorised-domain list, and the API key restrictions in the Cloud console.
#
# Read at BUILD time (Next inlines NEXT_PUBLIC_*), so deploys pass them with:
#   gcloud run deploy kavach --source . #     --set-build-env-vars "NEXT_PUBLIC_FIREBASE_API_KEY=...,..."
#
# Omitting them is supported: the app builds and every page works, but the
# sign-in button reports that authentication is not configured.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side, set at RUNTIME with --set-env-vars.
# Absent means the corpus ingest route refuses every request with a 404.
INGEST_TOKEN=
